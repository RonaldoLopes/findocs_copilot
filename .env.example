# ---- LLM ----
# Provedor padrão: gemini ou ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Confira no Google AI Studio qual modelo está disponível no free tier
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# ---- SQL Server ----
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=findocs
# Precisa de 8+ caracteres com maiúscula, minúscula, número e símbolo. TROQUE.
MSSQL_SA_PASSWORD=Troque-Esta-Senha-123
MSSQL_APP_USER=findocs_app
MSSQL_APP_PASSWORD=Troque-Esta-Senha-456
MSSQL_RO_USER=findocs_ro
MSSQL_RO_PASSWORD=Troque-Esta-Senha-789
# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB=findocs
# ---- Embeddings (RAG) ----
EMBEDDING_MODEL=intfloat/multilingual-e5-small